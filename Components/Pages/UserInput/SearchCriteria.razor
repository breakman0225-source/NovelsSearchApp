@using NovelsSearchApp.Components.Pages;
@using NovelsSearchApp.Models;
@using System.ComponentModel.DataAnnotations;

@rendermode InteractiveServer

@namespace NovelsSearchApp.Components.Pages.UserInput

@*Begin novel Search field.*@
<h2>小説検索</h2>
<EditForm Model="NovelParameters" OnValidSubmit="OnClickToSearch">
@*Begin search criteria input section*@
    <div>
        <div>
            <span>検索条件</span>
            <span>除外条件</span>
        </div>

        <div>
            <label>検索優先度高
                <input type="text" @bind="NovelParameters.HighPriorityCriteria"/>
            </label>
            <label>除外優先度高
                <input type="text" @bind="NovelParameters.Exceptword"/>
            </label>
        </div>

        <div>
            <label>検索優先度低
                <input type="text" @bind="NovelParameters.LowPriorityCriteria"/>
            </label>
            @*<label>除外優先度低
                <input type="text"@bind="LowPriorityExcept"/>
            </label>*@
        </div>
@*End search criteria input section*@

@*Begin order change section*@
    <div>
        <label>並び替え</label>
        <select name="order" @bind="NovelParameters.OrderSelect" @bind:after="HandleParamChangedAsync">
            <option value="new" selected>新着更新順</option>
            <option value="favnovelcnt">ブックマーク数の多い順</option>
            <option value="reviewcnt">レビュー数の多い順</option>
            <option value="hyoka">総合ポイントの高い順</option>
            <option value="dailypoint">日間ポイントの高い順</option>
            <option value="weeklypoint">週間ポイントの高い順</option>
            <option value="monthlypoint">月間ポイントの高い順</option>
            <option value="quarterpoint">四半期ポイントの高い順</option>
            <option value="yearlypoint">年間ポイントの高い順</option>
            <option value="impressioncnt">感想の多い順</option>
            <option value="hyokacnt">評価者の多い順</option>
            <option value="weekly">週間ユニークアクセスが多い順</option>
        </select>
    </div>
@*End order change section*@

@*Begin change the number of displaying novels section*@
    <div>
        <label>検索結果表示数変更</label>
        <select name="limNumber" @bind="NovelParameters.LimSelect" @bind:after="HandleParamChangedAsync">
            <option value="10">10</option>
            <option value="20" selected>20</option>
            <option value="30">30</option>
            <option value="40">40</option>
            <option value="50">50</option>
        </select>
    </div>
@*End change the number of displaying novels section*@

@*End novel Search field*@
        <div>
            <button type="submit">検索</button>
        </div>
    </div>
</EditForm>

@*Check connect of code-behind file.*@


@code{
    [Parameter] public EventCallback OnClickToSearch { get; set; }

    [Parameter] public EventCallback OnParamChanged { get; set; }
    //CriteriaOfSearchingNovels behindcodeSearching = new CriteriaOfSearchingNovels();
}