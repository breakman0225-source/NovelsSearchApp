@using NovelsSearchApp.Components.Pages;
@using NovelsSearchApp.Components.Pages.UserInput;
@using NovelsSearchApp.NovelModels;
@rendermode InteractiveServer

@namespace NovelsSearchApp.Components.Pages

@*Begin novel results*@
<div>
    @if(IsGettingAPISuccessInChild && IsSearchbuttonpushedInChild)
    {
        @if(NovelsInChild == null)
        {
            <span>小説が取得できませんでした。再試行してください。</span>
        }
        @*I will add else if statement for no results later. I plan to make program that measures the time null is assigned to novels and if it exceeds certain time, it will display some messages.*@
        else
        {
            @foreach(var novel in NovelsInChild)
            {
                <div>
                    <span>@novel.Title</span>
                    <span>@novel.Writer</span>            
                </div>
            }
        }
    }
    else if(IsGettingAPISuccessInChild || IsSearchbuttonpushedInChild)
    {
        <span>読み込み中です...</span>
    }
    else
    {
        <span>検索ボタンを押してください。</span>
    }
</div>
@*End novel results*@
@*I think above handle of wating to display searched results can be replaced with async handle.*@

    
@code{
    [Parameter] 
    public bool IsGettingAPISuccessInChild {get; set; }
    
    [Parameter]
    public IEnumerable<NovelModel>?  NovelsInChild {get; set; }
    
    [Parameter]
    public bool IsSearchbuttonpushedInChild {get; set;}
}