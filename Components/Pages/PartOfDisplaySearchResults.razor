@using Microsoft.VisualBasic
@using NovelsSearchApp.Components.Pages;
@using NovelsSearchApp.Components.Pages.UserInput;
@using NovelsSearchApp.Models
@rendermode InteractiveServer

@namespace NovelsSearchApp.Components.Pages


@*Begin novel results*@
<div>
    @if(IsGettingAPISuccessInChild && IsSearchbuttonpushedInChild)@*If getting API and button is pushed, display results of Searched novels.*@
    {
        @if(NovelsInChild != null)
        {
            @if(NovelParametersForPageCount.CurrentPageNumber < 2000)
            {
                <div>@ToCheckQueryParam</div>
                <div>@_pagenationMethodCheck</div>
                <div>@CheckDisplayTimesForPagenation</div>

                <div>
                    <div>
                        @if(NovelParametersForPageCount.CurrentPageNumber != 1)
                        {
                            <button @onclick="() => HandlePagenationAsync(MakePageList().FirstOrDefault())">@backArrowSymbol</button>
                            <button @onclick="() => HandlePagenationAsync(NovelParametersForPageCount.CurrentPageNumber - 1)">Back</button>
                        }


                        @foreach(var displayedPages in MakeDisplayPages())
                        {
                            @if(displayedPages == NovelParametersForPageCount.CurrentPageNumber)
                            {
                                <strong>@displayedPages</strong>
                            }
                            else
                            {
                                <button  @onclick="() => HandlePagenationAsync(displayedPages)">@displayedPages</button>
                            }
                            
                        }

                        @if(NovelParametersForPageCount.CurrentPageNumber != MakePageList().Last())
                        {
                            <button @onclick="() => HandlePagenationAsync(NovelParametersForPageCount.CurrentPageNumber + 1)">Next</button>
                            <button @onclick="() => HandlePagenationAsync(MakePageList().Last())">@forwardArrowSymbol</button>
                        }
                    </div>
                    

                    @foreach(var novel in NovelsInChild)
                    {
                        <div>
                            <p>@novel.Title</p>
                            <p>@novel.Writer</p>
                            <p>@novel.Story</p>
                            <a href="@GetNovelURL(novel.Ncode)" target="_blank" rel="noopener noreferrer">@GetNovelURL(novel.Ncode)</a>
                            <p>@GenreMapper.GetGenreValue(novel.Genre)</p> 
                            <p>@novel.Keyword</p>
                            <p>@novel.General_all_no</p>
                            <p>@novel.Global_point</p>
                            <p>@novel.Novelupdated_at</p>
                        </div>
                    }

                    <div>
                        @if(NovelParametersForPageCount.CurrentPageNumber != 1)
                        {
                            <button @onclick="() => HandlePagenationAsync(MakePageList().FirstOrDefault())">@backArrowSymbol</button>
                            <button @onclick="() => HandlePagenationAsync(NovelParametersForPageCount.CurrentPageNumber - 1)">Back</button>
                        }

                        @foreach(var displayedPages in MakeDisplayPages())
                        {
                            @if(displayedPages == NovelParametersForPageCount.CurrentPageNumber)
                            {
                                <strong>@displayedPages</strong>
                            }
                            else
                            {
                                <button  @onclick="() => HandlePagenationAsync(displayedPages)">@displayedPages</button>
                            }
                        }

                        @if(NovelParametersForPageCount.CurrentPageNumber != MakePageList().Last())
                        {
                            <button @onclick="() => HandlePagenationAsync(NovelParametersForPageCount.CurrentPageNumber + 1)">Next</button>
                            <button @onclick="() => HandlePagenationAsync(MakePageList().Last())">@forwardArrowSymbol</button>
                        }
                    </div>
                </div>
            }
            else
            {
                <p>2000作品以上表示することはできません。</p>
            }
        }
        else
        {
            <p>小説が取得できませんでした。再試行してください。</p>
        }
    }
    else if(IsGettingAPISuccessInChild || IsSearchbuttonpushedInChild)@*this is handle of displaying loading sentences.*@
    {
        <p>読み込み中です...</p>
    }
    @*I plan to add to the handle that if loading time exceed 15 minutes, display "読み込みに失敗しました。"*@
    else
    {
        <p>検索ボタンを押してください。</p>
    }
</div>
@*End novel results*@

@*Begin the number of pages of novels in lower area.*@
@*End the number of pages of novels in lower area.*@
    
@code{
    //This is Parameter zone.
    [Parameter] 
    public bool IsGettingAPISuccessInChild { get; set; }
    
    [Parameter]
    public IEnumerable<NovelModel>?  NovelsInChild { get; set; }
    
    [Parameter]
    public bool IsSearchbuttonpushedInChild { get; set;}

    [Parameter]
    public int GetAllcountForPageNumber { get; set; }

    [Parameter]
    public SearchConditionModel NovelParametersForPageCount { get; set; } = default!;

    [Parameter]
    public EventCallback OnPagenationParam { get; set; }

    [Parameter]
    public string? ToCheckQueryParam { get; set; }

    [Parameter]
    public int CheckDisplayTimesForPagenation { get; set; }

    private string backArrowSymbol = "<<";
    private string forwardArrowSymbol = ">>";
}